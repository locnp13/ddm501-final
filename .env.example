# Copy to .env (git-ignored) and set real values. The Kubernetes Secret is created from this file:
#   kubectl -n churn create secret generic churn-secrets --from-env-file=.env
# Key that must be entered in the web UI to approve or roll back a model. Leave empty to disable it.
# Generate one with: openssl rand -hex 24
ADMIN_KEY=change-me
# Password of the Grafana admin user (login: admin) at /grafana.
GRAFANA_ADMIN_PASSWORD=change-me
# Optional: send alerts to Telegram as well as the UI. Create a bot with @BotFather for the token; the chat id is
# an integer (negative for groups, find it with https://api.telegram.org/bot<TOKEN>/getUpdates after messaging the bot).
# Leave both empty to keep alerts in the web UI only. The Secret must be recreated and alertmanager restarted
# after a change: see k8s/README.md.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
