# Copy to .env (git-ignored) and set real values. The Kubernetes Secret is created from this file:
#   kubectl -n churn create secret generic churn-secrets --from-env-file=.env
# Key that must be entered in the web UI to approve or roll back a model. Leave empty to disable it.
# Generate one with: openssl rand -hex 24
ADMIN_KEY=change-me
# Password of the Grafana admin user (login: admin) at /grafana.
GRAFANA_ADMIN_PASSWORD=change-me
# Optional: send alerts to Telegram as well as the UI. Create a bot with @BotFather for the token; the chat id is
# an integer (negative for groups, find it with https://api.telegram.org/bot<TOKEN>/getUpdates after messaging the bot).
# Leave both empty to keep alerts in the web UI only. The Secret must be recreated and alertmanager restarted
# after a change: see k8s/README.md.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Infrastructure credentials (Docker Compose) ---
# Unset values fall back to the old defaults (minioadmin/minioadmin, mlflow/mlflow), which are public in the git
# history: set your own on any shared machine. Use letters and digits only (the Postgres one goes into a URL).
#
# MinIO (S3 storage for MLflow artifacts and the DVC remote). Takes effect on `docker compose up -d`.
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
#
# Postgres (MLflow metadata). Postgres only reads these when it creates an empty volume. To change the password of
# an existing volume, first run (with the old password still in use):
#   docker compose exec postgres psql -U mlflow -d mlflow -c "ALTER USER mlflow PASSWORD 'new-password';"
# then set POSTGRES_PASSWORD=new-password here and run `docker compose up -d mlflow`.
POSTGRES_USER=
POSTGRES_PASSWORD=
