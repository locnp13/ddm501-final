          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(sum(rate(churn_requests_total{status=~\"5..\"}[5m])) or vector(0)) / clamp_min(sum(rate(churn_requests_total[5m])), 1e-9)",
