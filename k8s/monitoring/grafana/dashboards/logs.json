{
  "uid": "churn-logs",
  "title": "Churn: Log",
  "description": "Log của các pod trong namespace churn, thu bằng Alloy và lưu trong Loki.",
  "tags": ["churn", "logs"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "30s",
  "time": {"from": "now-1h", "to": "now"},
  "annotations": {"list": []},
  "templating": {
    "list": [
      {
        "name": "request_id",
        "label": "Request ID",
        "type": "textbox",
        "query": "",
        "current": {"selected": false, "text": "", "value": ""},
        "options": [{"selected": true, "text": "", "value": ""}]
      },
      {
        "name": "search",
        "label": "Tìm trong log",
        "type": "textbox",
        "query": "",
        "current": {"selected": false, "text": "", "value": ""},
        "options": [{"selected": true, "text": "", "value": ""}]
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Dòng ERROR của API (1 giờ)",
      "description": "Lỗi 500 và lỗi không bắt được. Mỗi dòng có stack trace.",
      "datasource": {"type": "loki", "uid": "loki"},
      "gridPos": {"x": 0, "y": 0, "w": 6, "h": 5},
      "targets": [
        {
          "datasource": {"type": "loki", "uid": "loki"},
          "expr": "sum(count_over_time({app=\"api\", level=\"ERROR\"}[1h]))",
          "queryType": "instant",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "0",
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]},
          "color": {"mode": "thresholds"}
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Dòng WARNING của API (1 giờ)",
      "description": "Gồm các lần duyệt hoặc khôi phục model bị từ chối.",
      "datasource": {"type": "loki", "uid": "loki"},
      "gridPos": {"x": 6, "y": 0, "w": 6, "h": 5},
      "targets": [
        {
          "datasource": {"type": "loki", "uid": "loki"},
          "expr": "sum(count_over_time({app=\"api\", level=\"WARNING\"}[1h]))",
          "queryType": "instant",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "0",
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 1}]},
          "color": {"mode": "thresholds"}
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto"
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Số dòng log của API theo mức",
      "description": "Ba mức: INFO, WARNING, ERROR.",
      "datasource": {"type": "loki", "uid": "loki"},
      "gridPos": {"x": 12, "y": 0, "w": 12, "h": 5},
      "targets": [
        {
          "datasource": {"type": "loki", "uid": "loki"},
          "expr": "sum by (level) (count_over_time({app=\"api\", level!=\"\"}[$__interval]))",
          "queryType": "range",
          "legendFormat": "{{level}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {"lineWidth": 2, "fillOpacity": 10, "showPoints": "never", "spanNulls": false}
        },
        "overrides": [
          {"matcher": {"id": "byName", "options": "ERROR"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "red"}}]},
          {"matcher": {"id": "byName", "options": "WARNING"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "orange"}}]},
          {"matcher": {"id": "byName", "options": "INFO"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "blue"}}]}
        ]
      },
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}}
    },
    {
      "id": 4,
      "type": "logs",
      "title": "Cảnh báo và lỗi của API",
      "description": "Dòng WARNING và ERROR, mới nhất ở trên.",
      "datasource": {"type": "loki", "uid": "loki"},
      "gridPos": {"x": 0, "y": 5, "w": 24, "h": 9},
      "targets": [
        {
          "datasource": {"type": "loki", "uid": "loki"},
          "expr": "{app=\"api\", level=~\"WARNING|ERROR\"}",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "sortOrder": "Descending"
      }
    },
    {
      "id": 5,
      "type": "logs",
      "title": "Theo request id",
      "description": "Điền Request ID ở trên cùng để lần theo một lần gọi API (id nằm trong header X-Request-ID của phản hồi). Để trống thì hiện mọi yêu cầu.",
      "datasource": {"type": "loki", "uid": "loki"},
      "gridPos": {"x": 0, "y": 14, "w": 24, "h": 9},
      "targets": [
        {
          "datasource": {"type": "loki", "uid": "loki"},
          "expr": "{app=\"api\"} | request_id=~\"$request_id.*\"",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "sortOrder": "Descending"
      }
    },
    {
      "id": 6,
      "type": "logs",
      "title": "Mọi pod trong namespace churn",
      "description": "Log của api, frontend, Prometheus, Alertmanager, Grafana và alert-hub. Dùng ô Tìm trong log để lọc.",
      "datasource": {"type": "loki", "uid": "loki"},
      "gridPos": {"x": 0, "y": 23, "w": 24, "h": 10},
      "targets": [
        {
          "datasource": {"type": "loki", "uid": "loki"},
          "expr": "{namespace=\"churn\"} |~ \"(?i)$search\"",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": true,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "sortOrder": "Descending"
      }
    }
  ]
}
