    {
      "id": 19,
      "type": "bargauge",
      "title": "Drift đầu vào theo feature (PSI, 1 giờ)",
      "description": "PSI so với phân phối lúc huấn luyện: dưới 0,1 ổn định, 0,1 đến 0,2 lệch vừa, trên 0,2 lệch đáng kể (cảnh báo FeatureDrift). Chỉ tính khi có trên 100 dự đoán trong 1 giờ; trống nghĩa là chưa đủ dữ liệu hoặc model chưa có thống kê huấn luyện.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (feature)(churn:feature_psi:1h)",
          "legendFormat": "{{feature}}",
          "refId": "A",
          "editorMode": "code",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "max": 0.5,
          "decimals": 3,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.1
              },
              {
                "color": "red",
                "value": 0.2
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true
