          "refId": "B",
          "editorMode": "code",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "vector(0.37)",
          "legendFormat": "ngưỡng trên (+0,10)",
          "refId": "C",
          "editorMode": "code",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "vector(0.17)",
          "legendFormat": "ngưỡng dưới (-0,10)",
          "refId": "D",
          "editorMode": "code",
          "range": true
